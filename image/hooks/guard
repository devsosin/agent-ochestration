#!/bin/sh
# PreToolUse hook for project agents (image/settings/common.json). Exit 2 blocks the call and shows the message to the agent.
#  1. .env files: no access except .env.example (deny rules cannot carve out an exception, so it is done here).
#  2. File tools write only inside the project (AGENT_HUB_PROJECT_DIR), /tmp and Claude's project memory.
#  3. .claude/settings.json and settings.local.json stay with the user (repo permission rules and hooks live there).
#  4. git commit: no token or private key in what is being committed.
#  5. Merge gate: no `gh pr merge`, no push to and no commit on the default branch, unless the task was started with
#     `proj task --merge` (AGENT_HUB_ALLOW_MERGE=1 in claude's environment, which the agent's shell cannot change).
# shortcut: string matching on commands, so a determined shell can get around it; GitHub branch protection is the hard gate.
in="$(cat)"
tool="$(printf '%s' "$in" | jq -r '.tool_name // empty' 2>/dev/null)" || exit 0
[ -n "$tool" ] || exit 0
cwd="$(printf '%s' "$in" | jq -r '.cwd // empty')"
if [ "$tool" = Bash ]; then
  text="$(printf '%s' "$in" | jq -r '.tool_input.command // empty')"
else
  text="$(printf '%s' "$in" | jq -r '[.tool_input | (.file_path, .path, .notebook_path, .pattern, .glob) | strings] | join(" ")')"
fi
block() { echo "agent-hub guard: $*" >&2; exit 2; }

# A .env name starts after a path separator, space, quote, redirect or glob; .env.example (and copies of it) is fine.
envs="$(printf '%s\n' "$text" | grep -oE "(^|[/[:space:]\"'=<>:(*])\.env(rc)?(\.[A-Za-z0-9_.-]+)?" \
  | sed -E 's/^[^.]*//' | grep -vE '^\.env\.example' || true)"
[ -z "$envs" ] || block "$(echo $envs) is off limits: secrets stay out of agents. Use .env.example (key names only)."

settings="the repo's Claude settings (.claude/settings.json, settings.local.json) are changed by the user only. Say in your report what should change and why."
case "$tool" in Write|Edit|MultiEdit|NotebookEdit)
  f="$(printf '%s' "$in" | jq -r '.tool_input.file_path // .tool_input.notebook_path // empty')"
  case "$f" in /*) ;; *) f="${cwd:-$PWD}/$f" ;; esac
  # Lexical, so .. cannot step out and the file need not exist yet.
  f="$(printf '%s\n' "$f" | awk -F/ '{n = 0; for (i = 2; i <= NF; i++) { if ($i == "" || $i == ".") continue;
    if ($i == "..") { if (n > 0) n--; continue } p[++n] = $i } s = ""; for (i = 1; i <= n; i++) s = s "/" p[i]; print s}')"
  case "$f" in */.claude/settings.json|*/.claude/settings.local.json) block "$settings" ;; esac
  if [ -n "${AGENT_HUB_PROJECT_DIR:-}" ]; then
    case "$f" in
      "$AGENT_HUB_PROJECT_DIR"/*|/tmp/*|"${CLAUDE_CONFIG_DIR:-/home/node/.claude}"/projects/*) ;;
      *) block "$f is outside the project ($AGENT_HUB_PROJECT_DIR). Write only inside it, or in /tmp for scratch files." ;;
    esac
  fi ;;
esac
[ "$tool" = Bash ] || exit 0

if printf '%s\n' "$text" | grep -qE '\.claude/settings(\.local)?\.json' \
  && printf '%s\n' "$text" | grep -qE '>|sed[[:space:]]+-i|perl[[:space:]]+-[a-z]*i|(^|[^[:alnum:]_-])(tee|mv|cp|rm|truncate|ln|install|dd)([^[:alnum:]_-]|$)'; then
  block "$settings"
fi

commits=""; printf '%s\n' "$text" | grep -qE '(^|[^[:alnum:]_-])git[[:space:]]+commit' && commits=1
if [ -n "$commits" ]; then
  # Staged lines; with `git add` or `commit -a` in the same command, the working files too (not staged yet).
  pat='sk-ant-[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|AKIA[0-9A-Z]{16}|xox[abposr]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{35}|-----BEGIN [A-Z ]*PRIVATE KEY-----'
  all=""; printf '%s\n' "$text" | grep -qE 'git[[:space:]]+add|git[[:space:]]+commit[^;&|]*[[:space:]](-[a-zA-Z]*a|--all)' && all=1
  leaks="$(cd "${cwd:-.}" 2>/dev/null && { git diff --cached --name-only; [ -z "$all" ] || { git diff --name-only; git ls-files --others --exclude-standard; }; } 2>/dev/null \
    | sort -u | while IFS= read -r f; do
        { git diff --cached -U0 -- "$f" | sed -n 's/^+//p'; [ -z "$all" ] || cat -- "$f" 2>/dev/null; } | grep -qE "$pat" && printf '%s ' "$f"
      done)"
  [ -z "$leaks" ] || block "possible secret (token or private key) in: $leaks- take it out of the commit; secrets go in environment variables, never in the repo."
fi

[ "${AGENT_HUB_ALLOW_MERGE:-}" != 1 ] || exit 0
why="merging, and committing or pushing to the default branch, are only for merge tasks the user asked for (proj task --merge). Commit on your own branch, push it and open or update a pull request instead."
printf '%s\n' "$text" | grep -qE '(^|[^[:alnum:]_-])gh[[:space:]]+pr[[:space:]]+merge' && block "$why"
printf '%s\n' "$text" | grep -qE 'pulls/[0-9]+/merge' && block "$why"

default="$(git -C "${cwd:-.}" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')"
protected="main master ${default:-main}"
if [ -n "$commits" ]; then
  cur="$(git -C "${cwd:-.}" symbolic-ref -q --short HEAD 2>/dev/null || true)"
  for b in $protected; do [ "$cur" != "$b" ] || block "$why"; done
fi
pushes_protected() { # reads one `git push …` per line, prints x for each push that reaches a protected branch
  while IFS= read -r p; do
    set -f; set -- ${p#*push}; set +f
    n=0
    for w; do
      case "$w" in --all|--mirror) echo x; continue ;; -*) continue ;; esac
      n=$((n + 1))
      for b in $protected; do
        case "$w" in "$b"|*:"$b"|*/"$b"|+"$b") echo x ;; esac
      done
    done
    if [ "$n" -le 1 ]; then   # no refspec: pushes the current branch
      cur="$(git -C "${cwd:-.}" rev-parse --abbrev-ref HEAD 2>/dev/null)"
      for b in $protected; do [ "$cur" != "$b" ] || echo x; done
    fi
  done
}
# A function, not a loop inside $(…): bash 3.2 (macOS sh) misparses case patterns there.
bad="$(printf '%s\n' "$text" | tr ';&|' '\n\n\n' | grep -oE '(^|[[:space:](])git[[:space:]]+push([[:space:]].*)?$' | pushes_protected)"
[ -z "$bad" ] || block "$why"
exit 0
