{
  "permissions": { "deny": [] },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [{ "type": "command", "command": "/usr/local/lib/agent-hub/hooks/rust-check edit", "timeout": 10 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "/usr/local/lib/agent-hub/hooks/rust-check stop", "timeout": 900 }]
      }
    ]
  }
}
