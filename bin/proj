#!/usr/bin/env bash
# proj — per-project agent containers on the Mac mini. Usage: docs/proj.md, or `proj help`.
# Must stay compatible with macOS /bin/bash 3.2 (no ${x,,}, assoc arrays, mapfile; guard empty arrays).
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HUB="${AGENT_HUB_HOME:-$HOME/.agent-hub}"
if [ -f "$HUB/config" ]; then . "$HUB/config"; fi
WORKSPACE_ROOT="${WORKSPACE_ROOT:-$HOME/workspace}"
HARNESS_DIR="${HARNESS_DIR:-$WORKSPACE_ROOT/harness}"
REFS_DIR="$WORKSPACE_ROOT/refs"            # reference repo clones (proj ref), mounted read-only at /refs/<repo>
DEFAULT_ACCOUNT="${DEFAULT_ACCOUNT:-}"
MAX_TASKS="${MAX_TASKS:-2}"
IDLE_HOURS="${IDLE_HOURS:-3}"
USAGE_MAX="${USAGE_MAX:-0.95}"
USAGE_STALE="${USAGE_STALE:-1800}"
COMPOSE_FILE="$REPO_DIR/compose/project.yml"
CTR_TASKS=/var/agent-hub/tasks
PLUGINS_DIR="$HUB/plugins"           # marketplace clones, mounted read-only at /opt/plugins
HARNESS_MARKET=devsosin-harness      # marketplace at /opt/harness (image/managed-settings.json)

die() { echo "proj: $*" >&2; exit 1; }
tilde() { case "$1" in "$HOME"/*) printf '~%s' "${1#"$HOME"}" ;; *) printf '%s' "$1" ;; esac; }  # for display only

# --- names --------------------------------------------------------------------

valid_name() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$ ]]; }

# Compose project names allow only lowercase letters, digits, '-' and '_'.
compose_name() { printf 'proj-%s' "$(printf '%s' "$1" | tr 'A-Z.' 'a-z-')"; }
container() { printf '%s-agent-1' "$(compose_name "$1")"; }
env_file() { printf '%s/projects/%s.env' "$HUB" "$1"; }

require_project() {
  valid_name "$1" || die "invalid project name: $1"
  [ -f "$(env_file "$1")" ] || die "unknown project: $1 (proj ls)"
}

project_var() { # project_var <name> <KEY>
  sed -n "s/^$2=//p" "$(env_file "$1")" | head -1
}

dc() { # dc <name> <compose args...>
  local name="$1"; shift
  ensure_settings "$name"; mkdir -p "$PLUGINS_DIR"   # missing bind sources would become empty directories
  # Claude Code's session files (bind-mounted ~/.claude/projects) for transcript.md; made here so Docker does not create it.
  export SESSIONS_DIR="$HUB/sessions/$name"; mkdir -p "$SESSIONS_DIR"
  local refs; refs="$(refs_override "$name")"   # read-only reference repos (proj ref), if any
  # Shell env beats --env-file, so projects made before these variables existed get them too.
  MANAGED_SETTINGS="$(settings_file "$name")" PLUGINS_DIR="$PLUGINS_DIR" \
    docker compose -p "$(compose_name "$name")" --env-file "$(env_file "$name")" -f "$COMPOSE_FILE" ${refs:+-f "$refs"} "$@"
}

# Containers, volumes, networks the project's agent made through its Docker proxy (dockerproxy/server.py).
label_filter() { printf 'label=agent-hub.project=%s' "$1"; }
stop_started() { # stop_started <name>: stops the project's own containers (not its agent/proxy)
  local ids; ids="$(docker ps -q --filter "$(label_filter "$1")")"
  [ -z "$ids" ] || docker stop $ids >/dev/null
}
rm_started() { # rm_started <name>: deletes everything carrying the project label (user decision: re-creatable)
  local f ids; f="$(label_filter "$1")"
  ids="$(docker ps -aq --filter "$f")"; [ -z "$ids" ] || docker rm -f -v $ids >/dev/null
  ids="$(docker network ls -q --filter "$f")"; [ -z "$ids" ] || docker network rm $ids >/dev/null
  ids="$(docker volume ls -q --filter "$f")"; [ -z "$ids" ] || docker volume rm $ids >/dev/null
}

ensure_up() {
  [ "$(docker inspect -f '{{.State.Running}}' "$(container "$1")" 2>/dev/null)" = true ] || dc "$1" up -d --quiet-pull >/dev/null
}

# --- accounts -----------------------------------------------------------------

account_dir() { printf '%s/accounts/%s' "$HUB" "$1"; }

cmd_account() {
  local sub="${1:-ls}"; shift || true
  case "$sub" in
    add) account_add "$@" ;;
    ls) account_ls ;;
    use) account_use "$@" ;;
    *) die "usage: proj account add <alias> | ls | use <project> <alias>" ;;
  esac
}

account_add() {
  local alias="${1:-}" dir tok gh name email ans
  valid_name "$alias" || die "usage: proj account add <alias>"
  dir="$(account_dir "$alias")"
  if [ -d "$dir" ]; then
    read -rp "account '$alias' exists. replace its tokens? [y/N] " ans
    [ "$ans" = y ] || exit 0
  fi
  umask 077
  mkdir -p "$dir"
  echo "Claude token: run 'claude setup-token' while signed in to this account, then paste it here."
  # The token prints wrapped over two lines and a pasted newline ends `read`, so Enter reads the clipboard instead.
  read -rsp "Claude token (paste, or just Enter to use the clipboard): " tok; echo
  [ -n "$tok" ] || tok="$(pbpaste 2>/dev/null | tr -d '[:space:]')"
  [ -n "$tok" ] || die "empty token"
  # A wrapped token pasted as two lines arrives cut at the newline; refuse instead of saving half.
  case "$tok" in sk-ant-*) ;; *) die "token must start with sk-ant- (paste it as one line; nothing saved)" ;; esac
  if command -v claude >/dev/null; then
    echo "checking the token with one tiny request..."
    (cd /tmp && CLAUDE_CODE_OAUTH_TOKEN="$tok" ANTHROPIC_API_KEY= claude -p --max-turns 1 "Reply with exactly: ok" </dev/null >/dev/null 2>&1) \
      || die "Claude rejected the token (cut off when pasted?); nothing saved"
  fi
  read -rsp "GitHub token (fine-grained, empty to skip): " gh; echo
  # Empty values would reach git as an empty identity and break commits, so default to the host's.
  read -rp "git user.name [$(git config --global user.name)]: " name
  read -rp "git user.email [$(git config --global user.email)]: " email
  name="${name:-$(git config --global user.name)}"; email="${email:-$(git config --global user.email)}"
  [ -n "$name" ] && [ -n "$email" ] || die "git user.name and user.email are required; nothing saved"
  printf '%s' "$tok" > "$dir/claude.token"
  printf '%s' "$gh" > "$dir/gh.token"
  printf 'GIT_AUTHOR_NAME=%s\nGIT_AUTHOR_EMAIL=%s\nGIT_COMMITTER_NAME=%s\nGIT_COMMITTER_EMAIL=%s\n' \
    "$name" "$email" "$name" "$email" > "$dir/git.env"
  echo "saved account '$alias'. Running projects pick up new tokens on the next task."
}

account_use() { # proj account use <project> <alias>: the token is a container secret, so this recreates the container
  local name="${1:-}" alias="${2:-}"
  require_project "$name"
  [ -s "$(account_dir "$alias")/claude.token" ] || die "account '$alias' has no Claude token (proj account ls)"
  [ -z "$(running_tasks "$name")" ] || die "$name has running tasks; switch after they finish"
  set_var "$name" ACCOUNT "$alias"
  set_var "$name" ACCOUNT_DIR "$(account_dir "$alias")"
  # The token is a secret file; compose does not see a changed path as a change, so force it.
  dc "$name" up -d --force-recreate >/dev/null 2>&1 || die "could not recreate $name's containers (proj up $name)"
  [ "$(docker exec "$(container "$name")" sha256sum /run/secrets/claude_token | cut -d' ' -f1)" = \
    "$(shasum -a 256 "$(account_dir "$alias")/claude.token" | cut -d' ' -f1)" ] \
    || die "$name's container does not have $alias's token after recreating; check proj up $name"
  echo "$name now uses account $alias ($(usage_line "$alias"))"
}

account_ls() {
  local d a
  for d in "$HUB"/accounts/*/; do
    [ -d "$d" ] || continue
    a="$(basename "$d")"
    printf '%-12s claude=%s github=%s  %s%s\n' "$a" \
      "$([ -s "$d/claude.token" ] && echo yes || echo no)" \
      "$([ -s "$d/gh.token" ] && echo yes || echo no)" \
      "$(usage_line "$a")" \
      "$([ "$a" = "$DEFAULT_ACCOUNT" ] && echo '  (default)' || true)"
  done
}

# --- projects -----------------------------------------------------------------

cmd_build() {
  docker build -t agent-hub:dockerproxy "$REPO_DIR/dockerproxy"
  local tg f name want
  for tg in base web rust rust-web; do docker build --target "$tg" -t "agent-hub:$tg" "$REPO_DIR/image"; done
  # Images before the web split had Playwright in base: point out projects whose code now needs another image.
  for f in "$HUB"/projects/*.env; do
    [ -f "$f" ] || continue
    name="$(basename "$f" .env)"
    want="$(image_union "$(project_var "$name" IMAGE)" "$(image_for "$(project_var "$name" PROJECT_DIR)")")"
    [ "$want" = "$(project_var "$name" IMAGE)" ] || echo "note: $name uses $(project_var "$name" IMAGE), its code needs $want: proj image $name $want"
  done
}

cmd_new() {
  local name="${1:-}" repo="" create="" ws=0 account="$DEFAULT_ACCOUNT" image="" mem="6g" alias="" profile=dev dir
  valid_name "$name" || die "usage: proj new <name> [--repo URL|owner/name | --create [--public] | --workspace] [--alias 별칭] [--account A] [--image I] [--mem 6g] [--profile dev|marketing]"
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) repo="$2"; shift 2 ;;
      --create) create="${create:-private}"; shift ;;
      --public) create=public; shift ;;
      --workspace) ws=1; shift ;;
      --account) account="$2"; shift 2 ;;
      --image) image="$2"; shift 2 ;;
      --mem) mem="$2"; shift 2 ;;
      --alias) alias="$2"; shift 2 ;;
      --profile) profile="$2"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [ ! -f "$(env_file "$name")" ] || die "project already registered: $name"
  [ "$(printf '%s' "$name" | tr 'A-Z' 'a-z')" != refs ] || die "refs is reserved for reference repos ($(tilde "$REFS_DIR"), proj ref)"
  valid_profile "$profile" || die "unknown profile: $profile (profiles: $(profiles))"
  [ -n "$account" ] || die "no account: pass --account or set DEFAULT_ACCOUNT in $HUB/config"
  [ -s "$(account_dir "$account")/claude.token" ] || die "account '$account' has no Claude token (proj account add $account)"
  [ -d "$HARNESS_DIR" ] || die "harness not found at $HARNESS_DIR (set HARNESS_DIR)"

  [ -z "$repo" ] || [ -z "$create" ] || die "--repo and --create are exclusive"

  dir="$WORKSPACE_ROOT/$name"
  if [ "$ws" = 1 ]; then
    # A workspace holds several repos; add them with `proj add`.
    [ -z "$repo$create" ] || die "--workspace starts empty; add repos with proj add $name <repo> --repo|--create"
    mkdir -p "$dir"
  else
    fetch_repo "$dir" "$repo" "$create"
  fi
  dir="$(cd "$dir" && pwd -P)"
  if [ -z "$image" ]; then
    # Marketing work needs no toolchain or browser; switch with proj image when it does.
    if [ "$profile" = marketing ]; then image=agent-hub:base; else image="$(image_for "$dir")"; fi
  fi

  mkdir -p "$HUB/projects" "$HUB/tasks/$name"
  cat > "$(env_file "$name")" <<EOF
PROJECT_NAME=$name
PROJECT_DIR=$dir
ACCOUNT=$account
ACCOUNT_DIR=$(account_dir "$account")
TASKS_DIR=$HUB/tasks/$name
HARNESS_DIR=$HARNESS_DIR
IMAGE=$image
MEM_LIMIT=$mem
PROFILE=$profile
ALIAS=$alias
EOF
  docker volume create cargo-registry >/dev/null
  docker volume create cargo-git >/dev/null
  dc "$name" up -d
  sync_lsp "$name"
  echo "project '$name' ready: $(tilde "$dir") (account $account, image $image)"
}

is_repo() { # true only for the top of a git checkout (not a folder inside one)
  [ "$(git -C "$1" rev-parse --show-toplevel 2>/dev/null)" = "$(cd "$1" 2>/dev/null && pwd -P)" ]
}

uses_rust() { [ -f "$1/Cargo.toml" ] || ls "$1"/*/Cargo.toml >/dev/null 2>&1; }
uses_web() { [ -f "$1/package.json" ] || ls "$1"/*/package.json >/dev/null 2>&1; }

# Images (image/Dockerfile targets): base, web (Playwright), rust (toolchain, rust-analyzer), rust-web (both).
image_name() { # image_name <rust 0|1> <web 0|1>
  case "$1$2" in 11) echo agent-hub:rust-web ;; 10) echo agent-hub:rust ;; 01) echo agent-hub:web ;; *) echo agent-hub:base ;; esac
}
image_for() { # image_for <dir>: the image the code in <dir> needs (a workspace: its repos one level down)
  local r=0 w=0; uses_rust "$1" && r=1; uses_web "$1" && w=1; image_name "$r" "$w"
}
image_union() { # image_union <current> <needed>: our smallest image with both; an image of the user's own stays as it is
  local r=0 w=0 i
  case "$1" in agent-hub:base|agent-hub:web|agent-hub:rust|agent-hub:rust-web) ;; *) echo "$1"; return ;; esac
  for i in "$1" "$2"; do
    case "$i" in *rust*) r=1 ;; esac
    case "$i" in *web) w=1 ;; esac
  done
  image_name "$r" "$w"
}

# Claude Code's rust-analyzer LSP plugin, on in Rust images when its marketplace is on the host.
LSP_PLUGIN=rust-analyzer-lsp@claude-plugins-official
sync_lsp() { # sync_lsp <name>
  local on m="${LSP_PLUGIN#*@}"
  on="$(jq -r --arg p "$LSP_PLUGIN" '.enabledPlugins[$p] // false' "$(settings_file "$1")" 2>/dev/null || echo false)"
  case "$(project_var "$1" IMAGE)" in
    agent-hub:rust|agent-hub:rust-web)
      [ "$on" != true ] || return 0
      if [ -d "$PLUGINS_DIR/$m" ]; then plugin_add "$1" "$LSP_PLUGIN" >/dev/null && echo "$1: rust-analyzer LSP on ($LSP_PLUGIN)"
      else echo "note: for rust-analyzer in Claude Code, run: proj plugin source add anthropics/claude-plugins-official (then proj image $1 $(project_var "$1" IMAGE))"; fi ;;
    *) [ "$on" != true ] || plugin_rm "$1" "$LSP_PLUGIN" >/dev/null ;;   # no rust-analyzer in this image
  esac
}

fetch_repo() { # fetch_repo <dir> <repo: URL | owner/name | ""> <create: "" | private | public>
  local dir="$1" repo="$2" create="$3"
  if [ -n "$repo" ]; then
    [ ! -e "$dir" ] || die "$dir exists; drop --repo to adopt it"
    case "$repo" in
      *://*|git@*) git clone "$repo" "$dir" ;;
      */*) gh repo clone "$repo" "$dir" ;;   # host gh login, so private repos work too
      *) die "--repo takes a URL or owner/name: $repo" ;;
    esac
  elif [ ! -e "$dir" ]; then
    # An initial commit lets tasks branch into worktrees from the start.
    mkdir -p "$dir" && git -C "$dir" init -q -b main && git -C "$dir" commit -q --allow-empty -m "Initial commit"
  elif [ -n "$create" ]; then
    die "$dir exists; --create only makes new repos"
  fi
  if [ -n "$create" ]; then
    # Repo creation needs admin rights, so it uses the host's gh login, never a project token.
    gh repo create "$(basename "$dir")" "--$create" --source "$dir" --remote origin --push
  fi
}

set_var() { # set_var <name> <KEY> <value>: replace one line of the project's env file
  local f; f="$(env_file "$1")"
  { grep -v "^$2=" "$f" || true; echo "$2=$3"; } > "$f.tmp" && mv "$f.tmp" "$f"
}

cmd_add() { # proj add <workspace> <repo-folder> [--repo URL|owner/name | --create [--public]]
  local name="${1:-}" sub="${2:-}" repo="" create="" dir cur want
  require_project "$name"
  valid_name "$sub" || die "usage: proj add <workspace> <repo-folder> [--repo URL|owner/name | --create [--public]]"
  shift 2
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) repo="$2"; shift 2 ;;
      --create) create="${create:-private}"; shift ;;
      --public) create=public; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [ -z "$repo" ] || [ -z "$create" ] || die "--repo and --create are exclusive"
  dir="$(project_var "$name" PROJECT_DIR)"
  ! is_repo "$dir" || die "$name is a single-repo project; proj add is for workspaces (proj new <name> --workspace)"
  fetch_repo "$dir/$sub" "$repo" "$create"
  echo "added $sub to $name ($(tilde "$dir/$sub"))"
  cur="$(project_var "$name" IMAGE)"; want="$(image_union "$cur" "$(image_for "$dir/$sub")")"
  if [ "$want" != "$cur" ]; then
    if [ -z "$(running_tasks "$name")" ]; then
      set_var "$name" IMAGE "$want" && dc "$name" up -d >/dev/null 2>&1
      sync_lsp "$name"
      echo "switched $name to $want (for $sub)"
    else
      echo "note: $sub needs $want; switch after tasks finish: proj image $name $want"
    fi
  fi
}

cmd_image() { # proj image <name> <image>
  require_project "${1:-}"
  [ -n "${2:-}" ] || die "usage: proj image <name> agent-hub:base|web|rust|rust-web"
  [ -z "$(running_tasks "$1")" ] || die "$1 has running tasks; recreating the container would kill them"
  set_var "$1" IMAGE "$2" && dc "$1" up -d && sync_lsp "$1"
}

# --- reference repos (proj ref) ------------------------------------------------
# Host clones in $REFS_DIR, separate from project checkouts and kept on their default branch, so pulls never meet
# a task's branch. Each project mounts only the ones it lists (REFS in its env file): repos of one account stay
# out of other accounts' containers. Read-only in the container; the host pulls them before every task run.

refs_file() { printf '%s/projects/%s.refs.yml' "$HUB" "$1"; }

ref_name() { # ref_name <owner/repo | URL>: the repo's last path part without .git
  local n="${1%/}"; n="${n##*/}"; n="${n##*:}"; n="${n%.git}"
  valid_name "$n" && [ "$n" != refs ] && printf '%s' "$n"
}

refs_override() { # refs_override <name>: writes the compose file mounting the project's refs and prints its path (none: nothing)
  local f r lines=""; f="$(refs_file "$1")"
  for r in $(project_var "$1" REFS 2>/dev/null || true); do
    # A missing source would stop compose; the project keeps working without that ref.
    [ -d "$REFS_DIR/$r/.git" ] || { echo "proj: warning: reference repo $r is missing ($(tilde "$REFS_DIR/$r")); not mounted" >&2; continue; }
    lines="$lines      - { type: bind, source: \"$REFS_DIR/$r\", target: /refs/$r, read_only: true }
"
  done
  if [ -z "$lines" ]; then rm -f "$f"; return 0; fi
  printf 'services:\n  agent:\n    volumes:\n%s' "$lines" > "$f"
  printf '%s' "$f"
}

pull_ref() { # pull_ref <repo>: fast-forwards the clone; warns instead of prompting, and gives up on a stalled transfer
  # shortcut: no timeout on connecting (macOS has no timeout(1)); add one if a dead remote ever hangs task starts.
  GIT_TERMINAL_PROMPT=0 GIT_HTTP_LOW_SPEED_LIMIT=1000 GIT_HTTP_LOW_SPEED_TIME=20 \
    git -C "$REFS_DIR/$1" pull -q --ff-only >&2 2>&1 \
    || { echo "proj: warning: could not update reference repo $1; using it as is" >&2; return 1; }
}

refresh_refs() { # refresh_refs <name>: before a task run; a failed pull never stops the task
  local r
  for r in $(project_var "$1" REFS 2>/dev/null || true); do
    [ ! -d "$REFS_DIR/$r/.git" ] || pull_ref "$r" || true
  done
}

cmd_ref() { # proj ref add <name> <owner/repo|URL> | rm <name> <repo> | ls [name] | update [repo]
  local sub="${1:-ls}"; shift || true
  case "$sub" in
    add|rm) ref_change "$sub" "$@" ;;
    ls) ref_ls "${1:-}" ;;
    update) ref_update "${1:-}" ;;
    *) die "usage: proj ref add <name> <owner/repo|URL> | rm <name> <repo> | ls [name] | update [repo]" ;;
  esac
}

ref_change() { # ref_change add|rm <name> <source|repo>
  local op="$1" name="${2:-}" src="${3:-}" r d refs="" x
  require_project "$name"
  r="$(ref_name "$src")" || die "usage: proj ref $op <name> $([ "$op" = add ] && echo '<owner/repo|URL>' || echo '<repo>')"
  # The mounts change only when the container is recreated, which would kill running tasks.
  [ -z "$(running_tasks "$name")" ] || die "$name has running tasks; recreating its container would kill them. Retry after they finish"
  for x in $(project_var "$name" REFS); do [ "$x" = "$r" ] || refs="${refs:+$refs }$x"; done
  [ "$op" = add ] || [ "$refs" != "$(project_var "$name" REFS)" ] || die "$r is not mounted in $name (proj ref ls $name)"
  d="$REFS_DIR/$r"
  if [ "$op" = add ]; then
    case "$src" in */*|*:*) ;; *) die "proj ref add takes owner/repo or a URL: $src" ;; esac
    if [ -d "$d/.git" ]; then
      # Same folder name from another owner would silently show the wrong code.
      case "$(git -C "$d" remote get-url origin 2>/dev/null)" in
        *"/${src%.git}"|*"/${src%.git}.git"|"${src%.git}"|"${src%.git}.git"|*":${src%.git}"|*":${src%.git}.git") ;;
        *) die "$(tilde "$d") is a clone of $(git -C "$d" remote get-url origin 2>/dev/null || echo '?'), not $src" ;;
      esac
      echo "using the existing clone $(tilde "$d")"
    else
      mkdir -p "$REFS_DIR"; fetch_repo "$d" "$src" ""
    fi
    refs="${refs:+$refs }$r"
  fi
  set_var "$name" REFS "$refs"
  dc "$name" up -d
  if [ "$op" = add ]; then
    echo "$r is mounted read-only at /refs/$r in $name, and updated on the host before each task run."
    echo "Tell its agents in CLAUDE.md, e.g.: Reference repo $r (read-only, default branch): /refs/$r"
  else
    echo "$r unmounted from $name. The clone stays at $(tilde "$d") (proj ref ls shows which projects use it)."
  fi
}

ref_ls() { # ref_ls [name]: the project's refs, or every clone with its last commit and the projects using it
  local d r f users
  if [ -n "${1:-}" ]; then
    require_project "$1"
    for r in $(project_var "$1" REFS); do printf '%-24s /refs/%s  (%s)\n' "$r" "$r" "$(tilde "$REFS_DIR/$r")"; done
    return 0
  fi
  printf '%-24s %-20s %s\n' REPO LAST-COMMIT PROJECTS
  for d in "$REFS_DIR"/*; do
    [ -d "$d/.git" ] || continue
    r="$(basename "$d")"; users=""
    for f in "$HUB"/projects/*.env; do
      [ -f "$f" ] || continue
      case " $(sed -n 's/^REFS=//p' "$f" | head -1) " in *" $r "*) users="${users:+$users }$(basename "$f" .env)" ;; esac
    done
    printf '%-24s %-20s %s\n' "$r" "$(git -C "$d" log -1 --format='%h %cs' 2>/dev/null)" "${users:--}"
  done
}

ref_update() { # ref_update [repo]: pulls one clone or all of them
  local d bad=0
  if [ -n "${1:-}" ]; then
    [ -d "$REFS_DIR/$1/.git" ] || die "no reference repo $1 (proj ref ls)"
    pull_ref "$1" && echo "$1: $(git -C "$REFS_DIR/$1" log -1 --format='%h %s')"
    return
  fi
  for d in "$REFS_DIR"/*; do
    [ -d "$d/.git" ] || continue
    if pull_ref "$(basename "$d")"; then echo "$(basename "$d"): $(git -C "$d" log -1 --format='%h %s')"; else bad=1; fi
  done
  return "$bad"
}

cmd_ls() {
  local f name state
  # ALIAS goes last: printf pads by bytes, so Korean aliases would misalign later columns.
  printf '%-24s %-5s %-10s %-10s %-6s %s\n' PROJECT KIND ACCOUNT STATE TASKS ALIAS
  for f in "$HUB"/projects/*.env; do
    [ -f "$f" ] || continue
    name="$(basename "$f" .env)"
    # docker inspect prints an empty line for a missing container, so fall back outside the $(…).
    state="$(docker inspect -f '{{.State.Status}}' "$(container "$name")" 2>/dev/null)" || state=absent
    printf '%-24s %-5s %-10s %-10s %-6s %s\n' "$name" "$(is_repo "$(project_var "$name" PROJECT_DIR)" && echo repo || echo ws)" \
      "$(project_var "$name" ACCOUNT)" "$state" \
      "$(running_tasks "$name" | wc -l | tr -d ' ')" "$(project_var "$name" ALIAS)"
  done
}

cmd_up() { require_project "${1:-}"; dc "$1" up -d; }
cmd_down() { require_project "${1:-}"; stop_started "$1"; dc "$1" down; }

cmd_rm() { # proj rm <name> [--purge] [--yes]
  local name="${1:-}" purge=0 yes=0 dir unsaved what ans root
  require_project "$name"; shift
  while [ $# -gt 0 ]; do
    case "$1" in --purge) purge=1 ;; --yes) yes=1 ;; *) die "unknown option: $1" ;; esac; shift
  done
  [ -z "$(running_tasks "$name")" ] || die "$name has running tasks"
  dir="$(project_var "$name" PROJECT_DIR)"
  what="containers, Claude config volume, and the containers/volumes/networks the agent started (label agent-hub.project=$name)"
  if [ "$purge" = 1 ]; then
    root="$(cd "$WORKSPACE_ROOT" && pwd -P)"
    case "$dir" in "$root"/?*) ;; *) die "refusing to delete $dir: not inside $root" ;; esac
    unsaved="$(unsaved_work "$dir")"
    [ -z "$unsaved" ] || die "nothing removed — $dir has work that exists nowhere else:
$unsaved"
    what="$what, folder $dir, task records and transcripts"
  fi
  if [ "$yes" = 0 ]; then
    # Piped input is not consent: a person answers at a terminal; an agent passes --yes after the user agreed.
    [ -t 0 ] || die "confirmation needed: rerun with --yes after the user agrees to remove $what"
    read -rp "remove $what of '$name'? [y/N] " ans
    [ "$ans" = y ] || exit 0
  fi
  rm_started "$name"
  dc "$name" down -v
  rm -f "$(env_file "$name")" "$(settings_file "$name")" "$(refs_file "$name")"
  if [ "$purge" = 1 ]; then
    rm -rf "$dir" "$HUB/tasks/$name" "$HUB/sessions/$name"
    echo "removed $what"
  else
    echo "removed. kept: $(tilde "$dir"), $(tilde "$HUB/tasks/$name") (proj rm --purge also deletes them)"
  fi
}

unsaved_work() { # prints what would be lost by deleting the checkout; empty when everything is on a remote
  local w n e
  if ! is_repo "$1"; then
    # Workspace: check each repo; anything else at the top level exists only here.
    for e in "$1"/* "$1"/.[!.]*; do
      [ -e "$e" ] || continue
      case "$(basename "$e")" in .worktrees|.DS_Store) continue ;; esac
      if [ -d "$e" ] && is_repo "$e"; then unsaved_work "$e"; else echo "not in any repo: $e"; fi
    done
    return 0
  fi
  for w in $(git -C "$1" worktree list --porcelain | sed -n 's/^worktree //p'); do
    if [ -n "$(git -C "$w" status --porcelain 2>/dev/null)" ]; then echo "uncommitted changes in $w"; fi
  done
  n="$(git -C "$1" rev-list --branches --not --remotes | wc -l | tr -d ' ')"
  if [ "$n" != 0 ]; then echo "$n commit(s) on no remote: git -C $1 log --branches --not --remotes"; fi
}

cmd_alias() { # proj alias <name> <alias, e.g. 스모크>
  local name="${1:-}" alias="${2:-}"
  require_project "$name"
  [ -n "$alias" ] && [ "$alias" = "$(printf '%s' "$alias" | tr -d '\n=')" ] || die "usage: proj alias <name> <alias>"
  set_var "$name" ALIAS "$alias"
  echo "$name = $alias"
}

# --- plugins ------------------------------------------------------------------
# Marketplace repos are cloned on the host into $PLUGINS_DIR/<marketplace>/ and mounted read-only, so plugin
# code changes only here. Each project's managed settings (mounted read-only at
# /etc/claude-code/managed-settings.json) pick which plugins are on and their env options.

settings_file() { printf '%s/projects/%s.managed-settings.json' "$HUB" "$1"; }

ensure_settings() { # the image's managed settings (harness on) + env, with the project's profile rules kept current
  local f n d p tmp; f="$(settings_file "$1")"; n="$(project_profile "$1")"
  d="$(project_var "$1" PROJECT_DIR 2>/dev/null || true)"
  [ -f "$f" ] || jq '. + {env: {}}' "$REPO_DIR/image/managed-settings.json" > "$f"
  p="$(profile_json "$n")" || die "bad settings profile for $1 (proj profile $1 <profile>)"
  # For the hooks (image/hooks), also in proj shell sessions: work log columns and the project folder.
  p="$(printf '%s' "$p" | jq -c --arg n "$n" --arg d "$d" '. + {env: {AGENT_HUB_PROFILE: $n, AGENT_HUB_PROJECT_DIR: $d}}')"
  [ "$p" != "$(jq -c '{permissions, hooks, env: {AGENT_HUB_PROFILE: .env.AGENT_HUB_PROFILE, AGENT_HUB_PROJECT_DIR: .env.AGENT_HUB_PROJECT_DIR}}' "$f")" ] || return 0
  tmp="$(jq --argjson p "$p" '.permissions = $p.permissions | .hooks = $p.hooks | .env += $p.env' "$f")"
  printf '%s\n' "$tmp" > "$f"   # in place, see write_settings
}

# Settings profiles (image/settings): common.json for every project plus one team file, e.g. dev or marketing.
# Deny lists and hooks are joined. Tasks run with bypassPermissions, so only deny rules and hooks have effect.
project_profile() { local p; p="$(project_var "$1" PROFILE 2>/dev/null || true)"; echo "${p:-dev}"; }
profiles() { ls "$REPO_DIR/image/settings" | sed -n 's/\.json$//p' | grep -vx common | tr '\n' ' '; }
valid_profile() { [ "$1" != common ] && valid_name "$1" && [ -f "$REPO_DIR/image/settings/$1.json" ]; }
profile_json() {
  jq -cs '{permissions: {deny: (map(.permissions.deny // []) | add)},
           hooks: (reduce (.[].hooks // {} | to_entries[]) as $e ({}; .[$e.key] += $e.value))}' \
    "$REPO_DIR/image/settings/common.json" "$REPO_DIR/image/settings/$1.json" 2>/dev/null
}

cmd_profile() { # proj profile <name> [profile]
  local name="${1:-}"; require_project "$name"
  if [ -z "${2:-}" ]; then echo "$name: $(project_profile "$name")"; return; fi
  valid_profile "$2" || die "unknown profile: $2 (profiles: $(profiles))"
  set_var "$name" PROFILE "$2"; ensure_settings "$name"
  echo "$name: $2 (from the next task on)"
}

write_settings() { # write_settings <name> <jq args...> (input on stdin, so the args may end with --args)
  local f tmp; f="$(settings_file "$1")"; ensure_settings "$1"; shift
  tmp="$(jq "$@" < "$f")"
  # In place, not mv: a single-file bind mount keeps the old inode, so a replaced file would not reach the container.
  printf '%s\n' "$tmp" > "$f"
}

market_dir() { # host folder of a marketplace usable by the project
  if [ "$2" = "$HARNESS_MARKET" ]; then project_var "$1" HARNESS_DIR; else printf '%s/%s' "$PLUGINS_DIR" "$2"; fi
}

cmd_plugin() {
  case "${1:-ls}" in
    source) shift; plugin_source "$@" ;;
    ls) local f; for f in "$HUB"/projects/*.env; do [ -f "$f" ] || continue; plugin_ls "$(basename "$f" .env)"; done ;;
    *)
      local name="$1" sub="${2:-ls}"
      require_project "$name"; shift 2 || shift
      case "$sub" in
        add) plugin_add "$name" "$@" ;;
        rm) plugin_rm "$name" "$@" ;;
        ls) plugin_ls "$name" ;;
        *) die "usage: proj plugin <name> add <plugin@marketplace> [--env KEY=VALUE ...] | rm <plugin@marketplace> | ls" ;;
      esac ;;
  esac
}

plugin_source() { # proj plugin source add <owner/repo|URL> | update [marketplace] | ls
  local d tmp m
  mkdir -p "$PLUGINS_DIR"
  case "${1:-ls}" in
    add)
      [ -n "${2:-}" ] || die "usage: proj plugin source add <owner/repo|URL>"
      tmp="$(mktemp -d "$PLUGINS_DIR/.add.XXXXXX")"
      case "$2" in
        *://*|git@*) git clone -q "$2" "$tmp/r" ;;
        */*) gh repo clone "$2" "$tmp/r" -- -q ;;
        *) false ;;
      esac || { rm -rf "$tmp"; die "could not clone $2 (owner/repo or URL)"; }
      m="$(jq -r '.name // empty' "$tmp/r/.claude-plugin/marketplace.json" 2>/dev/null || true)"
      valid_name "$m" || { rm -rf "$tmp"; die "$2 has no .claude-plugin/marketplace.json with a valid name"; }
      [ "$m" != "$HARNESS_MARKET" ] && [ ! -e "$PLUGINS_DIR/$m" ] || { rm -rf "$tmp"; die "marketplace $m already exists (proj plugin source update $m)"; }
      mv "$tmp/r" "$PLUGINS_DIR/$m"; rmdir "$tmp"
      echo "added marketplace $m: $(jq -r '[.plugins[].name] | join(", ")' "$PLUGINS_DIR/$m/.claude-plugin/marketplace.json")"
      echo "turn one on: proj plugin <project> add <plugin>@$m" ;;
    update)
      for d in "$PLUGINS_DIR"/*/; do
        d="${d%/}"; [ -d "$d" ] || continue
        [ -z "${2:-}" ] || [ "$(basename "$d")" = "$2" ] || continue
        echo "== $(basename "$d")"; git -C "$d" pull -q --ff-only && git -C "$d" log -1 --format='%h %s'
      done ;;
    ls)
      for d in "$PLUGINS_DIR"/*/; do
        d="${d%/}"; [ -d "$d" ] || continue
        printf '%-24s %s %s  plugins: %s\n' "$(basename "$d")" "$(git -C "$d" log -1 --format=%h)" \
          "$(git -C "$d" remote get-url origin)" "$(jq -r '[.plugins[].name] | join(", ")' "$d/.claude-plugin/marketplace.json")"
      done ;;
    *) die "usage: proj plugin source add <owner/repo|URL> | update [marketplace] | ls" ;;
  esac
}

plugin_add() { # plugin_add <name> <plugin@marketplace> [--env KEY=VALUE ...] (KEY= removes KEY)
  local name="$1" p="${2:-}" m dir envs=()
  case "$p" in ?*@?*) ;; *) die "usage: proj plugin <name> add <plugin@marketplace> [--env KEY=VALUE ...]" ;; esac
  shift 2
  while [ $# -gt 0 ]; do
    case "$1" in
      --env) [[ "${2:-}" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || die "--env takes KEY=VALUE"; envs+=("$2"); shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  m="${p#*@}"; dir="$(market_dir "$name" "$m")"
  jq -e --arg n "${p%@*}" 'any(.plugins[]; .name == $n)' "$dir/.claude-plugin/marketplace.json" >/dev/null 2>&1 \
    || die "no plugin ${p%@*} in marketplace $m (proj plugin source ls)"
  write_settings "$name" --arg p "$p" --arg m "$m" --arg h "$HARNESS_MARKET" '
    .enabledPlugins[$p] = true
    | if $m == $h then . else .extraKnownMarketplaces[$m] = {source: {source: "directory", path: ("/opt/plugins/" + $m)}} end
    | .env = ((.env // {}) + ($ARGS.positional | map(capture("^(?<k>[^=]+)=(?<v>.*)$") | {(.k): .v}) | add // {})
             | with_entries(select(.value != "")))' --args ${envs[@]+"${envs[@]}"}
  echo "$name: $p on from the next task"
}

plugin_rm() { # plugin_rm <name> <plugin@marketplace>: drops the marketplace too when no other plugin of it is on
  local name="$1" p="${2:-}"
  case "$p" in ?*@?*) ;; *) die "usage: proj plugin <name> rm <plugin@marketplace>" ;; esac
  jq -e --arg p "$p" '.enabledPlugins | has($p)' "$(settings_file "$name")" >/dev/null 2>&1 || die "$p is not on in $name"
  write_settings "$name" --arg p "$p" --arg m "${p#*@}" --arg h "$HARNESS_MARKET" '
    del(.enabledPlugins[$p])
    | if $m == $h or any(.enabledPlugins | keys[]; endswith("@" + $m)) then . else del(.extraKnownMarketplaces[$m]) end'
  echo "$name: $p off from the next task (env options stay; clear one with add … --env KEY=)"
}

plugin_ls() {
  ensure_settings "$1"
  jq -r --arg n "$1" '(.env // {} | del(.AGENT_HUB_PROFILE, .AGENT_HUB_PROJECT_DIR)) as $e   # set by bin/proj, not plugin options
    | "\($n): \(.enabledPlugins | to_entries | map(select(.value) | .key) | join(", "))"
    + (if $e == {} then "" else "  env: \($e | to_entries | map("\(.key)=\(.value)") | join(" "))" end)' \
    "$(settings_file "$1")"
}

# --- hub (main agent on the host) --------------------------------------------
# Runs `claude remote-control` in $HUB/hub with the operating guide hub/CLAUDE.md and hub/settings.json
# (paths rewritten for WORKSPACE_ROOT / AGENT_HUB_HOME into $HUB/hub-settings.json, outside the hub's working dir).

HUB_LABEL=com.agent-hub.hub
hub_dir() { printf '%s/hub' "$HUB"; }
agent_plist() { printf '%s/Library/LaunchAgents/%s.plist' "$HOME" "$1"; }
hub_account() {
  local a="${HUB_ACCOUNT:-$DEFAULT_ACCOUNT}"
  [ -n "$a" ] || die "set HUB_ACCOUNT (or DEFAULT_ACCOUNT) in $HUB/config"
  echo "$a"
}
rule_path() { # permission-rule form of an absolute path: ~/x under $HOME, else //abs
  case "$1" in "$HOME"/*) printf '~%s' "${1#"$HOME"}" ;; *) printf '/%s' "$1" ;; esac
}
hub_settings() { # hub/settings.json with ~/workspace and ~/.agent-hub replaced by the configured paths
  local out="$HUB/hub-settings.json" ws hub
  ws="$(rule_path "$WORKSPACE_ROOT")"; hub="$(rule_path "$HUB")"
  # additionalDirectories takes plain paths; permission rules need the ~/ or // form.
  sed -e "/additionalDirectories/s|~/workspace|$WORKSPACE_ROOT|g" -e "/additionalDirectories/s|~/\.agent-hub|$HUB|g" \
      -e "s|~/workspace|$ws|g" -e "s|~/\.agent-hub|$hub|g" "$REPO_DIR/hub/settings.json" > "$out"
  echo "$out"
}
hub_ready() { # hub_ready <alias>: that account's host Claude config is logged in (proj hub login --account <alias>)
  jq -e '.oauthAccount' "$HOME/.claude-$1/.claude.json" >/dev/null 2>&1
}
config_set() { # config_set <KEY> <value>: replace one line of $HUB/config
  local f="$HUB/config"; mkdir -p "$HUB"; touch "$f"
  { grep -v "^$1=" "$f" || true; echo "$1=$2"; } > "$f.tmp" && mv "$f.tmp" "$f"
}
hub_claude() { # runs claude with the hub account's own login
  local bin="${CLAUDE_BIN:-$(command -v claude || true)}"
  [ -n "$bin" ] || die "claude CLI not found (install it, or set CLAUDE_BIN)"
  # proj on PATH lets the hub call it by name, which is what hub/settings.json allow rules match.
  PATH="$REPO_DIR/bin:$PATH" CLAUDE_CONFIG_DIR="$HOME/.claude-$(hub_account)" exec "$bin" "$@"
}

cmd_hub() {
  local sub="${1:-status}"; shift || true
  # First-time setup of another account: proj hub login|run --account <alias>
  if [ "${1:-}" = --account ]; then HUB_ACCOUNT="${2:-}"; shift 2; fi
  case "$sub" in
    init)
      mkdir -p "$(hub_dir)"
      ln -sfn "$REPO_DIR/hub/CLAUDE.md" "$(hub_dir)/CLAUDE.md"
      echo "hub dir: $(hub_dir) (account $(hub_account)). next: proj hub login, then proj hub run once" ;;
    login) cd "$(hub_dir)" && hub_claude ;;
    run)
      [ -f "$(hub_dir)/CLAUDE.md" ] || die "run: proj hub init"
      local settings; settings="$(hub_settings)"
      cd "$(hub_dir)"
      hub_claude remote-control --name hub --settings "$settings" ;;
    install) hub_install ;;
    uninstall) uninstall_agent "$HUB_LABEL" ;;
    use)
      local a="${1:-}"
      [ -n "$a" ] || die "usage: proj hub use <alias>"
      hub_ready "$a" || die "account $a is not set up for the hub. On the Mac mini's screen: proj hub login --account $a (log in, trust the folder, /exit), then proj hub run --account $a once (answer y, Ctrl+C), then proj hub use $a"
      config_set HUB_ACCOUNT "$a"
      ! launchctl print "gui/$(id -u)/$HUB_LABEL" >/dev/null 2>&1 || launchctl kickstart -k "gui/$(id -u)/$HUB_LABEL"
      echo "hub now uses account $a ($(usage_line "$a")). Open the hub from that account's Claude app." ;;
    status)
      echo "account  $(hub_account)  $(usage_line "$(hub_account)")"
      launchctl print "gui/$(id -u)/$HUB_LABEL" 2>/dev/null | grep -E '^\s*(state|pid|last exit code) =' || echo "hub service not installed"
      [ ! -f "$(hub_dir)/hub.log" ] || { echo "--- hub.log (tail)"; tail -5 "$(hub_dir)/hub.log"; } ;;
    *) die "usage: proj hub init|login|run|install|uninstall|status|use <alias>" ;;
  esac
}

hub_install() {
  local bin
  [ -f "$(hub_dir)/CLAUDE.md" ] || die "run: proj hub init"
  bin="${CLAUDE_BIN:-$(command -v claude || true)}"
  [ -n "$bin" ] || die "claude CLI not found"
  # remote-control exits after ~10 min without network; KeepAlive restarts it.
  CLAUDE_BIN="$bin" install_agent "$HUB_LABEL" "$(hub_dir)/hub.log" \
    '<key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>30</integer>' \
    "$REPO_DIR/bin/proj" hub run
  echo "hub service installed. proj hub status"
}

install_agent() { # install_agent <label> <log> <schedule plist keys> <program args...>
  local label="$1" log="$2" sched="$3" plist args="" a
  shift 3
  plist="$(agent_plist "$label")"
  for a in "$@"; do args="$args<string>$a</string>"; done
  mkdir -p "$(dirname "$plist")" "$(dirname "$log")"
  cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key><array>$args</array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$REPO_DIR/bin:${CLAUDE_BIN:+$(dirname "$CLAUDE_BIN"):}/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>AGENT_HUB_HOME</key><string>$HUB</string>
    <key>CLAUDE_BIN</key><string>${CLAUDE_BIN:-}</string>
  </dict>
  $sched
  <key>StandardOutPath</key><string>$log</string>
  <key>StandardErrorPath</key><string>$log</string>
</dict>
</plist>
EOF
  plutil -lint -s "$plist"
  launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$plist"
}

uninstall_agent() {
  launchctl bootout "gui/$(id -u)/$1" 2>/dev/null || true
  rm -f "$(agent_plist "$1")"; echo "$1 removed"
}

cmd_shell() {
  require_project "${1:-}"; ensure_up "$1"
  docker exec -it -w "$(project_var "$1" PROJECT_DIR)" "$(container "$1")" bash -l
}

# --- usage, model, idle ---------------------------------------------------------
# Usage comes from the rate_limit_event lines claude writes into task logs, so it is
# as fresh as the account's last task. Windows whose reset time has passed count as 0.

usage_source() { # newest file holding the account's rate-limit data (task log or probe); prints "<mtime> <path>"
  local f m newest="" best=0
  for f in "$HUB"/tasks/*/*/log.jsonl "$HUB/usage/$1.jsonl"; do
    [ -s "$f" ] || continue
    case "$f" in */usage/*) ;; *) [ "$(meta "$(dirname "$f")" ACCOUNT)" = "$1" ] || continue ;; esac
    m="$(stat -f %m "$f")"
    if [ "$m" -gt "$best" ]; then best="$m"; newest="$f"; fi
  done
  [ -z "$newest" ] || echo "$best $newest"
}

usage_probe() { # one minimal request (no tools, tiny prompt, Haiku: ~900 tokens) just to read the account's limits
  local bin; bin="${CLAUDE_BIN:-$(command -v claude || true)}"
  [ -n "$bin" ] && [ -s "$(account_dir "$1")/claude.token" ] || return 0
  mkdir -p "$HUB/usage"
  (cd /tmp && CLAUDE_CODE_OAUTH_TOKEN="$(cat "$(account_dir "$1")/claude.token")" ANTHROPIC_API_KEY= \
    "$bin" -p --tools "" --system-prompt "Reply with ok." --strict-mcp-config --setting-sources "" \
      --no-session-persistence --model claude-haiku-5-5 --output-format stream-json --verbose "ok" </dev/null 2>/dev/null) \
    | grep '"rate_limit_event"' | tail -1 > "$HUB/usage/$1.jsonl.tmp" || true
  if [ -s "$HUB/usage/$1.jsonl.tmp" ]; then mv "$HUB/usage/$1.jsonl.tmp" "$HUB/usage/$1.jsonl"; else rm -f "$HUB/usage/$1.jsonl.tmp"; fi
}

usage_windows() { # usage_windows <alias> -> lines "five_hour 0.81 <resetsAt> allowed"
  local newest
  newest="$(usage_source "$1")"; newest="${newest#* }"
  [ -n "$newest" ] || return 0
  grep '"rate_limit_event"' "$newest" | tail -1 | jq -r --argjson now "$(date +%s)" '
    .rate_limit_info.unifiedWindows // {} | to_entries[]
    | "\(.key) \(if .value.resetsAt < $now then 0 else .value.utilization end) \(.value.resetsAt) \(if .value.resetsAt < $now then "allowed" else .value.status end)"'
}

usage_line() {
  local w u r st out=""
  while read -r w u r st; do
    [ -n "$w" ] || continue
    out="$out$(printf '%s %s%%' "$(echo "$w" | sed 's/five_hour/5h/;s/seven_day/7d/')" "$(awk -v u="$u" 'BEGIN{printf "%d", u*100}')")"
    [ "$u" = 0 ] || out="$out (until $(date -r "$r" '+%m/%d %H:%M'))"
    [ "$st" = allowed ] || out="$out [$st]"
    out="$out  "
  done <<EOF
$(usage_windows "$1")
EOF
  echo "${out:-usage: no data yet}"
}

usage_ok() { # dies when the account is at or over USAGE_MAX in any window; refreshes data older than USAGE_STALE
  local w u r st src
  src="$(usage_source "$1")"
  [ -n "$src" ] && [ $(( $(date +%s) - ${src%% *} )) -lt "$USAGE_STALE" ] || usage_probe "$1"
  while read -r w u r st; do
    [ -n "$w" ] || continue
    # allowed_warning (sent from ~75%) still works; only rejected or USAGE_MAX stops new tasks.
    if [ "$st" = rejected ] || awk -v u="$u" -v m="$USAGE_MAX" 'BEGIN{exit !(u >= m)}'; then
      die "account $1 is at $(awk -v u="$u" 'BEGIN{printf "%d", u*100}')% of its $w limit until $(date -r "$r" '+%m/%d %H:%M'). Switch: proj account use <project> <alias>, or wait"
    fi
  done <<EOF
$(usage_windows "$1")
EOF
}

cmd_usage() { # proj usage [--refresh]
  local d
  if [ "${1:-}" = --refresh ]; then
    for d in "$HUB"/accounts/*/; do [ -d "$d" ] && usage_probe "$(basename "$d")"; done
  fi
  for d in "$HUB"/accounts/*/; do
    [ -d "$d" ] && printf '%-12s %s\n' "$(basename "$d")" "$(usage_line "$(basename "$d")")"
  done
  echo "(latest task or probe per account; --refresh asks Claude now, ~900 tokens each. USAGE_MAX=$USAGE_MAX blocks new tasks)"
}

cmd_model() { # proj model <project> [model | -]: read at each launch, no restart needed
  require_project "${1:-}"
  if [ -z "${2:-}" ]; then echo "${1}: $(project_var "$1" MODEL || true)"; return; fi
  set_var "$1" MODEL "$([ "$2" = - ] || echo "$2")"
  echo "$1 model: $([ "$2" = - ] && echo default || echo "$2")"
}

last_activity() { # newest of: task file change, container start (epoch seconds)
  local t s
  t="$(find "$HUB/tasks/$1" -type f -exec stat -f %m {} + 2>/dev/null | sort -n | tail -1)"
  s="$(docker inspect -f '{{.State.StartedAt}}' "$(container "$1")" 2>/dev/null)"
  s="$(date -j -u -f '%Y-%m-%dT%H:%M:%S' "${s%%.*}" +%s 2>/dev/null || echo 0)"
  echo "${t:-0} $s" | tr ' ' '\n' | sort -n | tail -1
}

idle_stop() { # stops running containers with no task, no shell, and no activity for <hours>
  local hours="$1" f name c idle busy
  for f in "$HUB"/projects/*.env; do
    [ -f "$f" ] || continue
    name="$(basename "$f" .env)"; c="$(container "$name")"
    [ "$(docker inspect -f '{{.State.Running}}' "$c" 2>/dev/null)" = true ] || continue
    [ -z "$(running_tasks "$name")" ] || continue
    # Anything besides init and the keep-alive sleep means someone is using it (proj shell, a command).
    # (`docker top -o comm` fails on OrbStack, so ask ps inside the container; `ps` is this check itself.)
    busy="$(docker exec "$c" ps -eo comm= 2>/dev/null | grep -cvxE 'docker-init|tini|sleep|ps' || true)"
    [ "$busy" = 0 ] || continue
    idle=$(( $(date +%s) - $(last_activity "$name") ))
    if [ "$idle" -ge $(( hours * 3600 )) ]; then
      # Containers the agent started (test DBs, dev servers) are not activity; they stop with it.
      stop_started "$name" 2>/dev/null || true
      dc "$name" stop >/dev/null 2>&1 && echo "$(date '+%F %T') stopped $name (idle $(( idle / 60 )) min)"
    fi
  done
  return 0
}

cmd_idle() { # proj idle [hours] | install [hours] | uninstall
  case "${1:-}" in
    install)
      install_agent com.agent-hub.idle "$HUB/idle.log" '<key>StartInterval</key><integer>1800</integer>' \
        "$REPO_DIR/bin/proj" idle "${2:-$IDLE_HOURS}"
      echo "every 30 min: stop containers idle for ${2:-$IDLE_HOURS}h. log: $HUB/idle.log" ;;
    uninstall) uninstall_agent com.agent-hub.idle ;;
    *) idle_stop "${1:-$IDLE_HOURS}" ;;
  esac
}

# --- tasks --------------------------------------------------------------------
# Task dir: $HUB/tasks/<project>/<id>/ — meta (KEY=value), prompt.txt, prompts.log, log.jsonl,
# stderr.log, pid (pid inside the container), exit (written when claude ends), transcript.md (built on the host).

task_dir() { # task_dir <id> -> path, searching all projects
  local d
  for d in "$HUB"/tasks/*/"$1"; do [ -d "$d" ] && { echo "$d"; return; }; done
  die "unknown task: $1"
}
meta() { sed -n "s/^$2=//p" "$1/meta" | tail -1; }

task_state() { # done | failed | running | lost
  local d="$1" project
  if [ -f "$d/exit" ]; then
    [ "$(cat "$d/exit")" = 0 ] && [ "$(result_field "$d" is_error)" != true ] && echo done || echo failed
    return
  fi
  project="$(meta "$d" PROJECT)"
  if [ -s "$d/pid" ] && docker exec "$(container "$project")" kill -0 "$(cat "$d/pid")" 2>/dev/null; then
    echo running
  else
    echo lost
  fi
}

running_tasks() { # running_tasks [project] -> task dirs
  local d
  for d in "$HUB"/tasks/${1:-*}/*/; do
    [ -f "$d/meta" ] && [ ! -f "$d/exit" ] || continue
    [ "$(task_state "${d%/}")" = running ] && echo "${d%/}"
  done
  return 0
}

result_field() { # last result event's field from log.jsonl
  [ -s "$1/log.jsonl" ] || return 0
  jq -rs --arg k "$2" '[.[] | select(.type == "result")] | last | .[$k] // empty' "$1/log.jsonl" 2>/dev/null || true
}

session_id() {
  [ -s "$1/log.jsonl" ] || return 0
  jq -r 'select(.type == "system" and .subtype == "init") | .session_id' "$1/log.jsonl" 2>/dev/null | tail -1
}

can_launch() { # checks that must pass before a task leaves any trace (branch, worktree, record)
  [ "$(running_tasks | wc -l | tr -d ' ')" -lt "$MAX_TASKS" ] || die "MAX_TASKS=$MAX_TASKS tasks already running (proj status)"
  usage_ok "$(project_var "$1" ACCOUNT)"
}

launch() { # launch <task dir> [session id to resume]
  local d="$1" resume="${2:-}" id project workdir sys model merge
  id="$(basename "$d")"; project="$(meta "$d" PROJECT)"; workdir="$(meta "$d" WORKDIR)"
  can_launch "$project"
  refresh_refs "$project"
  model="$(project_var "$project" MODEL || true)"
  sys="You run inside an agent-hub project container. Task $id, working directory $workdir"
  if [ -n "$(meta "$d" BRANCH)" ]; then
    sys="$sys on branch $(meta "$d" BRANCH) (from $(meta "$d" BASE)). Commit your changes on this branch with clear messages; do not switch branches."
    [ -z "$(meta "$d" FROM)" ] || sys="$sys $(meta "$d" BASE) holds earlier work on this topic from another session: read its git log and its diff against the default branch before you continue."
    sys="$sys If you split work across parallel subagents that edit files, give each one its own worktree (Agent tool isolation: \"worktree\") and merge their results into this branch."
  else
    sys="$sys on the checked-out branch. Do not commit unless the task asks."
  fi
  if ! is_repo "$workdir"; then
    sys="$sys This is a multi-repo workspace: each subfolder with its own .git is a separate repository. Commit in the repository you changed, on a new branch, never on its default branch."
  fi
  merge="$(meta "$d" MERGE)"
  if [ -n "$merge" ]; then
    sys="$sys This is a merge task: the user asked to merge. You may switch to the pull requests' branches. Merge them one at a time in the order the task gives: bring each up to date with its base branch, resolve conflicts, run the project's checks, push, then merge with gh pr merge (a repo without a remote, or branches without a pull request: git merge into the default branch locally). Stop and report if a conflict needs a product decision."
  else
    sys="$sys Do not merge pull requests, git merge into the default branch, or push to it: merging happens only in merge tasks the user asks for."
  fi
  sys="$sys Do not push or open pull requests unless the task asks. End with a short report: what changed, how you verified it, open questions. In the report, give file paths relative to the working directory, never absolute."
  rm -f "$d/exit" "$d/pid"
  echo "ACCOUNT=$(project_var "$project" ACCOUNT)" >> "$d/meta"   # usage is tracked per account
  ensure_up "$project"; ensure_settings "$project"   # profile rules from the repo, for this run
  # Detached inside the container so the run outlives this shell; the sh pid marks it running.
  docker exec -d ${merge:+-e AGENT_HUB_ALLOW_MERGE=1} "$(container "$project")" sh -c '
    t="$1"; w="$2"; s="$3"; shift 3
    echo $$ > "$t/pid"
    cd "$w" || { echo 127 > "$t/exit"; exit 0; }
    agent-run -p --output-format stream-json --verbose --permission-mode bypassPermissions \
      --append-system-prompt "$s" "$@" < "$t/prompt.txt" >> "$t/log.jsonl" 2>> "$t/stderr.log"
    echo $? > "$t/exit"' sh "$CTR_TASKS/$id" "$workdir" "$sys" ${model:+--model "$model"} ${resume:+--resume "$resume"}
  echo "$id started ($project). proj status $id · proj logs $id -f"
}

new_task_id() { # yymmdd-HHMMSS, plus -2, -3… when that second is taken in any project (task_dir looks ids up globally)
  local base n=1 id
  base="$(date +%y%m%d-%H%M%S)"; id="$base"
  while ls -d "$HUB"/tasks/*/"$id" >/dev/null 2>&1; do n=$((n + 1)); id="$base-$n"; done
  echo "$id"
}

default_branch() { # origin's default branch, else main/master, else the current branch
  local b
  b="$(git -C "$1" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [ -n "$b" ] && git -C "$1" rev-parse -q --verify "refs/heads/${b#origin/}" >/dev/null; then echo "${b#origin/}"; return; fi
  for b in main master; do
    if git -C "$1" rev-parse -q --verify "refs/heads/$b" >/dev/null; then echo "$b"; return; fi
  done
  git -C "$1" rev-parse --abbrev-ref HEAD
}

task_workdir() { # task_workdir <dir> <id> <worktree 0|1> [base branch]: checks, then sets WORKDIR BRANCH BASE (git changes only after all checks)
  local dir="$1" id="$2" wt="$3" t tw
  WORKDIR="$dir"; BRANCH=""; BASE=""
  if [ "$wt" = 0 ]; then
    # One agent per checkout: refuse when a running task works in this folder, inside it, or above it.
    for t in $(running_tasks); do
      tw="$(meta "$t" WORKDIR)"
      case "$tw" in */.worktrees/*) continue ;; esac   # --worktree tasks have their own folder
      case "$dir/" in "$tw/"*) die "task $(basename "$t") is already working in $(tilde "$tw"); wait for it, or use --worktree for parallel work" ;; esac
      case "$tw/" in "$dir/"*) die "task $(basename "$t") is already working in $(tilde "$tw"); wait for it, or use --worktree for parallel work" ;; esac
    done
  fi
  is_repo "$dir" && git -C "$dir" rev-parse -q --verify HEAD >/dev/null 2>&1 || {
    [ "$wt" = 0 ] || die "--worktree needs a git repository with a commit"
    [ -z "${4:-}" ] || die "--from needs a git repository; pick one with --repo <folder>"
    return 0   # workspace root or empty repo: in place, no branch
  }
  BASE="${4:-$(default_branch "$dir")}"; BRANCH="agent/$id"
  git -C "$dir" rev-parse -q --verify "refs/heads/$BASE" >/dev/null || die "no branch $BASE in $(tilde "$dir") (wrong --repo?)"
  for t in /.worktrees/ /.claude/worktrees/; do   # task and subagent worktrees stay out of git status
    grep -qxF "$t" "$dir/.git/info/exclude" 2>/dev/null || echo "$t" >> "$dir/.git/info/exclude"
  done
  if [ "$wt" = 1 ]; then
    WORKDIR="$dir/.worktrees/$id"
    git -C "$dir" worktree add -q -b "$BRANCH" "$WORKDIR" "$BASE"
  else
    [ -z "$(git -C "$dir" status --porcelain)" ] \
      || die "$(tilde "$dir") has uncommitted changes ($(git -C "$dir" rev-parse --abbrev-ref HEAD)); commit or discard them first, or use --worktree"
    git -C "$dir" switch -q -c "$BRANCH" "$BASE"
  fi
}

cmd_task() {
  local name="${1:-}" wt=0 sub="" from="" merge="" id dir d prompt WORKDIR BRANCH BASE
  require_project "$name"; shift
  while :; do
    case "${1:-}" in
      --worktree) wt=1; shift ;;
      --repo) sub="${2:-}"; shift 2 ;;
      --from) from="${2:-}"; shift 2 ;;   # task id or branch: new session on a new branch cut from it
      --merge) merge=1; shift ;;   # the user asked to merge: lifts the guard hook's merge gate for this task
      --*) die "unknown option: $1" ;;   # not silently part of the prompt
      *) break ;;
    esac
  done
  if [ "${1:-}" = - ]; then prompt="$(cat)"; else prompt="$*"; fi
  [ -n "$prompt" ] || die "usage: proj task <name> [--repo <folder>] [--worktree] [--from <task|branch>] [--merge] <prompt...|->"
  if [ -n "$from" ] && [ -d "$(task_dir "$from" 2>/dev/null || true)" ]; then
    from="$(meta "$(task_dir "$from")" BRANCH)"
    [ -n "$from" ] || die "task has no branch to continue from"
  fi
  dir="$(project_var "$name" PROJECT_DIR)"
  if [ -n "$sub" ]; then
    dir="$dir/$sub"
    is_repo "$dir" || die "$sub is not a git repository in $name (proj add $name $sub …)"
  fi
  can_launch "$name"
  id="$(new_task_id)"
  d="$HUB/tasks/$name/$id"
  task_workdir "$dir" "$id" "$wt" "$from"

  mkdir -p "$d"
  printf '%s\n' "$prompt" > "$d/prompt.txt"
  printf '## %s\n%s\n\n' "$(date '+%F %T')" "$prompt" > "$d/prompts.log"
  printf 'PROJECT=%s\nWORKDIR=%s\nBRANCH=%s\nBASE=%s\nCREATED=%s\n' \
    "$name" "$WORKDIR" "$BRANCH" "$BASE" "$(date '+%F %T')" > "$d/meta"
  [ -z "$from" ] || echo "FROM=$from" >> "$d/meta"
  [ -z "$merge" ] || echo "MERGE=1" >> "$d/meta"
  launch "$d"
}

cmd_reply() {
  local id="${1:-}" d sid prompt w b t
  [ -n "$id" ] || die "usage: proj reply <task> <prompt...|->"
  d="$(task_dir "$id")"; shift
  [ "$(task_state "$d")" != running ] || die "$id is still running"
  if [ "${1:-}" = - ]; then prompt="$(cat)"; else prompt="$*"; fi
  [ -n "$prompt" ] || die "empty prompt"
  sid="$(session_id "$d")"
  [ -n "$sid" ] || die "$id has no session to resume (see $d/stderr.log)"
  w="$(meta "$d" WORKDIR)"; b="$(meta "$d" BRANCH)"
  # Resume needs the session file and the folder it ran in; otherwise start fresh from the task's branch.
  [ -d "$w" ] && [ -n "$(find "$HUB/sessions/$(meta "$d" PROJECT)" -name "$sid.jsonl" 2>/dev/null | head -1)" ] \
    || die "cannot resume $id: its session or folder is gone. Start a new session from its branch: proj task $(meta "$d" PROJECT) --from $id <prompt>"
  if [ -n "$b" ] && [ -d "$w" ] && [ "$(git -C "$w" rev-parse --abbrev-ref HEAD)" != "$b" ]; then
    # Checkout task whose checkout moved on (proj close or a later task): resume on its own branch.
    for t in $(running_tasks); do
      [ "$(meta "$t" WORKDIR)" != "$w" ] || die "task $(basename "$t") is working in $(tilde "$w"); wait for it"
    done
    [ -z "$(git -C "$w" status --porcelain)" ] || die "$(tilde "$w") has uncommitted changes; commit or discard them first"
    git -C "$w" switch -q "$b"
  fi
  printf '%s\n' "$prompt" > "$d/prompt.txt"
  printf '## %s\n%s\n\n' "$(date '+%F %T')" "$prompt" >> "$d/prompts.log"
  launch "$d" "$sid"
}

cmd_status() {
  local d
  if [ -n "${1:-}" ] && [ -f "$(env_file "$1")" ]; then status_list "$1"; return; fi
  if [ -z "${1:-}" ]; then status_list "*"; return; fi
  d="$(task_dir "$1")"
  transcript_fresh "$d"
  printf 'task     %s\nproject  %s\nstate    %s\nbranch   %s\nworkdir  %s\ncreated  %s\n' \
    "$1" "$(meta "$d" PROJECT)" "$(task_state "$d")" "$(meta "$d" BRANCH)" "$(tilde "$(meta "$d" WORKDIR)")" "$(meta "$d" CREATED)"
  [ ! -f "$d/transcript.md" ] || printf 'transcript %s\n' "$(tilde "$d/transcript.md")"
  printf 'cost     %s USD, %s turns\n\n' "$(result_field "$d" total_cost_usd)" "$(result_field "$d" num_turns)"
  result_field "$d" result
  if [ -s "$d/stderr.log" ]; then echo; echo "--- stderr (tail)"; tail -5 "$d/stderr.log"; fi
}

status_list() {
  local d
  printf '%-14s %-20s %-8s %s\n' TASK PROJECT STATE PROMPT
  for d in "$HUB"/tasks/$1/*/; do
    [ -f "$d/meta" ] || continue
    d="${d%/}"
    [ -f "$(env_file "$(meta "$d" PROJECT)")" ] || continue   # project removed with `proj rm`
    transcript_fresh "$d"
    printf '%-14s %-20s %-8s %s\n' "$(basename "$d")" "$(meta "$d" PROJECT)" "$(task_state "$d")" \
      "$(head -1 "$d/prompt.txt" | cut -c1-60)"
  done
}

cmd_logs() {
  local d filter
  [ -n "${1:-}" ] || die "usage: proj logs <task> [-f]"
  d="$(task_dir "$1")"
  filter='select(.type == "assistant") | .message.content[]?
    | if .type == "text" then .text
      elif .type == "tool_use" then "→ \(.name) \(.input | tostring | .[0:160])"
      else empty end'
  if [ "${2:-}" = -f ]; then
    # Stops when the task ends, so callers (the hub agent) are never left with an endless process.
    ( tail -n +1 -F "$d/log.jsonl" 2>/dev/null | jq --unbuffered -r "$filter" ) 2>/dev/null &
    local p=$!
    wait_task "$d" 86400 || true
    sleep 1; pkill -P "$p" 2>/dev/null || true; kill "$p" 2>/dev/null || true
  else
    [ -s "$d/log.jsonl" ] && jq -r "$filter" "$d/log.jsonl"
    [ ! -s "$d/stderr.log" ] || { echo "--- stderr"; cat "$d/stderr.log"; }
  fi
}

# transcript.md: the task's Claude sessions (main agent + subagents) as Markdown with local times, read from
# Claude Code's own session files. The container's ~/.claude/projects is bind-mounted at $HUB/sessions/<project>.
# A run ends inside the container, so the file is (re)built on the host: proj transcript, or proj status/wait once stale.
TRANSCRIPT_JQ='
  def clip: gsub("\\s+"; " ") | .[0:160];
  def body: if type == "string" then . elif type == "array" then map(.text? // empty) | join("\n") else "" end;
  [.[] | select((.type == "user" or .type == "assistant") and (.sessionId as $s | $sids | index($s)) and (.isMeta | not))]
  | unique_by(.uuid) | sort_by(.timestamp)
  | (map(.message.content | arrays | .[] | select(.type == "tool_use")
         | {key: .id, value: ((.input.subagent_type // .name) + (if .input.description then " (\(.input.description))" else "" end))})
     | from_entries) as $uses
  | (map(select((.toolUseResult | objects | .agentId) != null)
         | {key: .toolUseResult.agentId, value: $uses[.message.content[0].tool_use_id?]}) | from_entries) as $agents
  | .[]
  | (if .isSidechain then "subagent \($agents[.agentId // ""] // .agentId // "?")" elif .type == "assistant" then "agent"
      elif ([.message.content | arrays | .[] | select(.type == "tool_result")] | length) > 0 then "tool" else "user" end) as $who
  | (.message.content
     | if type == "string" then .
       else map(
         if .type == "text" then .text
         elif .type == "tool_use" then "→ \(.name): \(.input | (.command // .file_path // .pattern // .description // .prompt // .url // tostring) | clip)"
         elif .type == "tool_result" then (.content | body) as $r
           | if $r != "" and ($r | length) <= 300 and ($r | split("\n") | length) <= 3 then "← \($r | clip)" else empty end
         else empty end) | join("\n") end) as $text
  | select($text != "")
  | "**\(.timestamp | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601 | strflocaltime("%Y-%m-%d %H:%M:%S")) · \($who)**\n\($text)\n"
  | gsub("(sk-ant-|ghp_|gho_|ghs_|ghu_|github_pat_)[A-Za-z0-9_-]+"; "[REDACTED]")
  | gsub("(?<k>[A-Z_]*(TOKEN|SECRET|PASSWORD|API_KEY))=[^\\s]+"; "\(.k)=[REDACTED]")'

transcript_md() { # transcript_md <task dir>: prints the Markdown; fails when no session file is found
  local d="$1" dir sids s
  dir="$HUB/sessions/$(meta "$d" PROJECT)"
  # Every run (first and each proj reply) logs its session id; a resume may keep or change it.
  sids="$(jq -r 'select(.type == "system" and .subtype == "init") | .session_id' "$d/log.jsonl" 2>/dev/null | sort -u)"
  [ -n "$sids" ] || return 1
  set --
  for s in $sids; do set -- "$@" -e "\"sessionId\":\"$s\""; done
  # Every file holding a record of these sessions: main transcript and subagent transcripts alike.
  [ -n "$(grep -rlF --include='*.jsonl' "$@" "$dir" 2>/dev/null | head -1)" ] || return 1
  printf '# Task %s (%s)\n\n' "$(basename "$d")" "$(meta "$d" PROJECT)"
  grep -rlF --null --include='*.jsonl' "$@" "$dir" \
    | xargs -0 jq -rs --argjson sids "$(printf '%s\n' "$sids" | jq -R . | jq -s .)" "$TRANSCRIPT_JQ"
}

cmd_transcript() {
  local d
  [ -n "${1:-}" ] || die "usage: proj transcript <task>"
  d="$(task_dir "$1")"
  transcript_md "$d" > "$d/transcript.md.tmp" \
    || { rm -f "$d/transcript.md.tmp"; die "no session records for $1 in $(tilde "$HUB/sessions/$(meta "$d" PROJECT)") (task started before the sessions mount? proj up $(meta "$d" PROJECT))"; }
  mv "$d/transcript.md.tmp" "$d/transcript.md"
  echo "$(tilde "$d/transcript.md")"
}

transcript_fresh() { # rebuilds transcript.md when the task finished after it was last written
  [ -f "$1/exit" ] || return 0
  [ ! -f "$1/transcript.md" ] || [ "$1/exit" -nt "$1/transcript.md" ] || return 0
  # A stub when there is nothing to read (task ran before the sessions mount), so status does not search again each time.
  (cmd_transcript "$(basename "$1")") >/dev/null 2>&1 \
    || printf '# Task %s\n\nNo session records found. Retry: proj transcript %s\n' "$(basename "$1")" "$(basename "$1")" > "$1/transcript.md"
}

wait_task() { # wait_task <task dir> <timeout s>: returns 0 when finished, 3 on timeout
  local d="$1" timeout="$2" waited=0 state
  while :; do
    state="$(task_state "$d")"
    # A just-launched task has no pid yet and reads as lost; give it 30s to start.
    [ "$state" = running ] || { [ "$state" = lost ] && [ "$waited" -lt 30 ]; } || return 0
    [ "$waited" -lt "$timeout" ] || return 3
    sleep 5; waited=$((waited + 5))
  done
}

cmd_wait() {
  local d
  [ -n "${1:-}" ] || die "usage: proj wait <task> [timeout-seconds, default 1800]"
  d="$(task_dir "$1")"
  if ! wait_task "$d" "${2:-1800}"; then
    echo "$1 still running after ${2:-1800}s (proj wait $1 again, or proj logs $1)"
    return 3
  fi
  cmd_status "$1"
}

cmd_diff() {
  local d w base r b
  [ -n "${1:-}" ] || die "usage: proj diff <task>"
  d="$(task_dir "$1")"; w="$(meta "$d" WORKDIR)"; base="$(meta "$d" BASE)"
  if ! is_repo "$w"; then
    for r in "$w"/*/; do
      r="${r%/}"; is_repo "$r" || continue
      echo "== $(basename "$r") ($(git -C "$r" rev-parse --abbrev-ref HEAD))"
      git -C "$r" status --short
      git -C "$r" log --oneline --branches --not --remotes | head -5
    done
    echo; echo "open: code $(tilde "$w")"; echo "      vscode://vscode-remote/ssh-remote+macmini$w"
    return
  fi
  b="$(meta "$d" BRANCH)"; b="${b:-HEAD}"
  echo "== uncommitted (on $(git -C "$w" rev-parse --abbrev-ref HEAD))"; git -C "$w" status --short
  if [ -n "$base" ]; then
    echo "== commits since $base"; git -C "$w" log --oneline "$base..$b"
    echo "== diffstat $base...$b"; git -C "$w" diff --stat "$base...$b"
  fi
  echo
  echo "open: code $(tilde "$w")"
  echo "      vscode://vscode-remote/ssh-remote+macmini$w"
}

cmd_close() {
  local d w b
  [ -n "${1:-}" ] || die "usage: proj close <task>"
  d="$(task_dir "$1")"
  [ "$(task_state "$d")" != running ] || die "$1 is still running"
  w="$(meta "$d" WORKDIR)"
  b="$(meta "$d" BRANCH)"
  case "$w" in
    */.worktrees/*)
      if [ -n "$b" ] && [ -d "$w" ]; then
        # Refuses on uncommitted changes, so nothing is lost; the branch stays.
        git -C "$(dirname "$(dirname "$w")")" worktree remove "$w" \
          || die "worktree has uncommitted changes; commit or discard them first"
        echo "removed worktree $(tilde "$w") (branch $b kept)"
      fi ;;
    *)
      # Checkout task: deletes nothing; leaves the checkout alone unless it is clean and still on the task branch.
      if [ -n "$b" ] && [ "$(git -C "$w" rev-parse --abbrev-ref HEAD 2>/dev/null)" = "$b" ]; then
        if [ -z "$(git -C "$w" status --porcelain)" ]; then
          git -C "$w" switch -q "$(meta "$d" BASE)"
          echo "$(tilde "$w") back on $(meta "$d" BASE) (branch $b kept)"
        else
          echo "$(tilde "$w") has uncommitted changes; staying on $b"
        fi
      fi ;;
  esac
  touch "$d/closed"
}

usage() {
  cat <<'EOF'
proj — per-project agent containers (docs/proj.md)

  proj build                               build agent-hub:base, web, rust, rust-web, dockerproxy
  proj account add <alias> | ls            store / list account tokens
  proj new <name> [--repo URL|owner/name | --create [--public] | --workspace] [--alias 별칭] [--account A] [--image I] [--mem 6g] [--profile dev|marketing]
  proj add <workspace> <folder> [--repo URL|owner/name | --create [--public]]   add a repo to a workspace
  proj image <name> agent-hub:base|web|rust|rust-web   (new/add pick it from the code)
  proj model <name> [model|-]                 model for the project's tasks (- = default)
  proj account use <name> <alias>             switch a project to another account
  proj usage [--refresh]                      5h / 7d limit usage per account
  proj idle [hours] | install [hours] | uninstall   stop idle containers (default 3h)
  proj hub init|login|run|install|uninstall|status   main agent on the host (Remote Control)
  proj hub use <alias> | login|run --account <alias>  switch the hub to another account / set one up
  proj imagegen install|uninstall|status|run         image MCP for containers (host Codex login)
  proj plugin source add <owner/repo|URL> | update [marketplace] | ls   plugin marketplaces on the host
  proj plugin <name> add <plugin@marketplace> [--env KEY=VALUE ...] | rm <plugin@marketplace> | ls
  proj plugin ls                              plugins on in every project
  proj profile <name> [dev|marketing]         permission and hook profile (image/settings): show / switch
  proj alias <name> <별칭>                  set the alias the hub matches (e.g. 스모크)
  proj ref add <name> <owner/repo|URL> | rm <name> <repo>   reference repo mounted read-only at /refs/<repo>
  proj ref ls [name] | update [repo]          clones in $WORKSPACE_ROOT/refs (pulled before each task run)
  proj ls | up <name> | down <name> | shell <name>
  proj rm <name> [--purge] [--yes]         also deletes what the agent started in Docker; --purge: folder, task records
  proj task <name> [--repo <folder>] [--worktree] [--from <task|branch>] [--merge] <prompt...|->  run claude on a new branch agent/<id> in the checkout (--worktree: in .worktrees/<id>, for parallel work)
  proj reply <task> <prompt...|->          continue the task's session
  proj status [task|name] | wait <task> [secs] | logs <task> [-f] | diff <task> | close <task>
  proj transcript <task>                   (re)build the task's transcript.md (also done by status/wait once it ends)
EOF
}

# --- imagegen (MCP server on the host, uses the host's Codex ChatGPT login) ---------
IMAGEGEN_PORT=7801  # same port in image/mcp.json and mcp-web.json
cmd_imagegen() { # proj imagegen run [codex] | install | uninstall | status
  case "${1:-status}" in
    run)
      IMAGEGEN_PORT="$IMAGEGEN_PORT" IMAGEGEN_DIR="$HUB/imagegen" CODEX_BIN="${2:-codex}" \
        exec /usr/bin/python3 "$REPO_DIR/imagegen/server.py" ;;
    install)
      local codex; codex="$(command -v codex || true)"
      [ -n "$codex" ] || die "codex CLI not found (install it, then: codex login)"
      "$codex" login status 2>&1 | grep -q ChatGPT || die "codex is not logged in with ChatGPT: run codex login"
      install_agent com.agent-hub.imagegen "$HUB/imagegen.log" \
        '<key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>30</integer>' \
        "$REPO_DIR/bin/proj" imagegen run "$codex"
      echo "imagegen on 127.0.0.1:$IMAGEGEN_PORT (containers: host.docker.internal). log: $HUB/imagegen.log" ;;
    uninstall) uninstall_agent com.agent-hub.imagegen ;;
    status)
      curl -fsS -m 3 "http://127.0.0.1:$IMAGEGEN_PORT/health" >/dev/null 2>&1 && echo "imagegen: up (port $IMAGEGEN_PORT)" || echo "imagegen: down"
      [ ! -f "$HUB/imagegen.log" ] || tail -5 "$HUB/imagegen.log" ;;
    *) die "usage: proj imagegen run|install|uninstall|status" ;;
  esac
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    build|account|new|add|image|alias|model|usage|idle|ls|up|down|rm|shell|task|reply|status|wait|logs|transcript|diff|close|hub|imagegen|plugin|profile|ref) "cmd_$cmd" "$@" ;;
    help|-h|--help) usage ;;
    *) usage >&2; exit 1 ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
